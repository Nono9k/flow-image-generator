{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 60000
    },

    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://127.0.0.1:9222"
        ]
      }
    }
  }
}
